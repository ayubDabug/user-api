{
    "version": 2,
    "builds": [
        {
            "src": "api/index.js",  
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            // Matches /api/user/register
            "src": "/api/user/(.*)",  
            // The path is now rewritten to target the standard file location
            "dest": "/api/index.js/$1"  
        },
        {
            // Fallback for the base URL (e.g., /)
            "src": "/(.*)",
            "dest": "/api/index.js"
        }
    ]
}
